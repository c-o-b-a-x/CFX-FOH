# ── Required ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Channel ID where finished orders are posted and pinged
ORDER_CHANNEL_ID=

# ── Pings (optional, comma separated IDs) ───────────────────────────────────
# Role IDs to ping on every new order (the role must be mentionable by the bot)
PING_ROLE_IDS=
# Extra user IDs to ping on every new order
PING_USER_IDS=
ORDER_PING_MESSAGE=New order received!

# ── /purge command ──────────────────────────────────────────────────────────
# User IDs allowed to run /purge (mass delete messages). When empty, the
# PING_USER_IDS list above is used. Roles cannot run the command.
PURGE_ALLOWED_USER_IDS=

# ── Ticket detection ────────────────────────────────────────────────────────
# Channel name pattern (case-insensitive). Default matches ticket-1234 / Ticket-1234
TICKET_CHANNEL_REGEX=^ticket-\d{4}$
# Seconds to wait after channel creation before posting the form, so the
# ticket tool's own controls/messages appear first (0 disables the wait)
TICKET_RESPONSE_DELAY_SECONDS=5

# ── Form behaviour ─────────────────────────────────────────────────────────
# How long (in minutes) the bot keeps waiting for a form reply in a ticket
FORM_TIMEOUT_MINUTES=1440
# Max number of files forwarded per order (Discord allows 10 per message)
MAX_ATTACHMENTS=10
# Max total size of forwarded files in MB
MAX_ATTACHMENT_MB=20
# Embed accent colour (hex, # optional)
EMBED_COLOR=f1c40f
# Set to true to log order payloads instead of posting them (useful for testing)
DRY_RUN=false
